# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase project used by AIM in preview and production.
FIREBASE_PROJECT_ID="gen-lang-client-0573723214"
# On Vercel, store the full service-account JSON as a server-only secret.
# It must belong to FIREBASE_PROJECT_ID and be allowed to verify Auth users.
# For local development or an attached Google service identity, Application
# Default Credentials may be used instead; never commit either credential.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional: only needed for the separate Google Drive connect feature.
VITE_GOOGLE_CLIENT_ID=""

# Optional AI Studio/Cloud Run compatibility setting, not used for Vercel API routing.
APP_URL=""

# Server-only Google Play verification. Keep charging off until device tests pass.
PLAY_PACKAGE_NAME="com.itsmelocsta.aim"
PLAY_SERVICE_ACCOUNT_JSON=""
PLAY_BILLING_ENABLED="false"
# Authenticated Pub/Sub push identity and exact endpoint audience.
PLAY_RTDN_AUDIENCE=""
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=""
