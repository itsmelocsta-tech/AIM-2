# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Fractal Life Mapping can be disabled independently without removing user data.
VITE_ENABLE_FRACTAL_LIFE_MAP="true"
VITE_ENABLE_FRACTAL_PROPAGATION="true"

# Server only. Configure Google Play credentials through secret settings.
# The Pub/Sub push subscription must use this exact audience and service-account email.
PLAY_RTDN_AUDIENCE=""
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=""
AIM_PAYMENTS_ENABLED="false"

# Android build settings. Never commit signing keys or passwords.
AIM_ANDROID_WEB_ORIGIN=""
ANDROID_KEYSTORE_PATH=""
ANDROID_KEY_ALIAS=""
