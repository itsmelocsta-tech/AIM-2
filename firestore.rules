rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict User Isolation:
    // A user can ONLY read and write documents inside their own user document and subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Billing is readable by its owner but only trusted Admin SDK code may write it.
      // A separate deny match would not override the recursive owner's allow.
      match /{collectionId}/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
                     && collectionId != 'billing';
      }
    }
  }
}
